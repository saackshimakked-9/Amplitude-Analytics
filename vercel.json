{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/dealer-count.js": { "maxDuration": 60 },
    "api/dealers.js": { "maxDuration": 30 },
    "api/metrics.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ]
}
